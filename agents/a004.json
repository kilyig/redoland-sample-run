  {
   "eid": "e004302",
   "kind": "narrate",
   "text": "Year 10: 15 food appears in the pile for 12 people.",
   "who": "the village",
   "year": 10
  },
  {
   "eid": "e004303",
   "kind": "take",
   "text": "Esa takes 2 from the pile (pile now 13).",
   "who": "Esa",
   "year": 10
  },
  {
   "eid": "e004304",
   "kind": "take",
   "text": "Vela takes 2 from the pile (pile now 11).",
